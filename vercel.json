{
  "rewrites": [
    {
      "source": "/read",
      "destination": "/index.html"
    },
    {
      "source": "/read.html",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(september-en|september-fr)/pages/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/women-of-the-year-preview.html",
      "destination": "/women-of-the-year-2026/",
      "permanent": true
    }
  ]
}
